# Copy to .env.local for development. Nothing here is read by the browser: the
# api/ routes read process.env, and only VITE_-prefixed names reach the client.

# --- admin auth (api/auth/*) -------------------------------------------------
# Without both of these the dashboard opens unauthenticated in development and
# refuses to log anyone in, which is deliberate: a half-configured secret must
# never look like a working lock.
ADMIN_PASSWORD=
# Any long random string. Rotating it logs the admin out. Generate one with:
#   node -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
ADMIN_SESSION_SECRET=

# --- storage -----------------------------------------------------------------
# Vercel injects these once a KV (Upstash Redis) store and a Blob store are
# linked to the project; `vercel env pull .env.local` brings them down. With the
# KV pair absent the API keeps its counters and content in process memory, so
# dev works offline and nothing survives a restart.
KV_REST_API_URL=
KV_REST_API_TOKEN=
BLOB_READ_WRITE_TOKEN=

# --- local media (see docs/media-files.md) -----------------------------------
# Masters live in local-media/ and are never built into dist/.
VITE_DEV_MP3_URL=
VITE_DEV_WAV_URL=
VITE_DEV_AUDIO_URL=
